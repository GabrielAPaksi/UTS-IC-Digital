# For the iCE40HX-8K Breakout Board

# Physical Constraints File (PCF) for iCESugar-v1.5 + TM1638

set_io clk 35
set_io heartbeat 41
set_io tm_cs  47
set_io tm_clk 2
set_io tm_dio 3
set_io -pullup yes sw[0] 18
set_io -pullup yes sw[1] 19
set_io -pullup yes sw[2] 20

